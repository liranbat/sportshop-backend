# Template — copy to .env (dev) or .env.prod (Docker prod). Both are gitignored;
# same keys, env-specific values.

# --- Database connection ---
# In prod, SPORTSHOP_DB_HOST is the compose service name (`db`), not localhost.
# SPORTSHOP_DB_NAME / USER / PASSWORD MUST match deploy/.env.prod.db's
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD respectively, otherwise
# Postgres rejects the connection on first up.
SPORTSHOP_DB_HOST=localhost
SPORTSHOP_DB_PORT=5432
SPORTSHOP_DB_NAME=sportshop
SPORTSHOP_DB_SCHEMA=sportshop
SPORTSHOP_DB_USER=sportshop_app
SPORTSHOP_DB_PASSWORD=change_me

# --- CORS ---
# In dev, the Vite dev server is same-origin (proxy forwards /api/* + /images/*),
# but the SPA itself is served from http://localhost:5173. In prod, Caddy is
# same-origin on https://localhost:46443. Whitelist whichever applies.
SPORTSHOP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Image storage ---
# Dev: a sibling folder on disk. Prod: the in-container path bind-mounted from
# deploy/.data/images (see docker-compose.yml). SeedImagesBootstrap copies seed
# files from the JAR into this dir on startup; existing files are not clobbered.
SPORTSHOP_IMAGES_LOCAL_DIR=../../images

# --- JWT / cookies ---
# Required, no default — generate via `openssl rand -base64 48`.
SPORTSHOP_JWT_SECRET=hRdYi1nFwM4vCuaC/e9Uih6EdicnpC3BZ6oK8Tc1szKp6MHiEvf6enXlrhbUw1pz
SPORTSHOP_ACCESS_TOKEN_TTL=PT15M
SPORTSHOP_REFRESH_TOKEN_TTL=P14D
# false in dev (plain http://localhost:5173 — browsers reject Secure cookies on http).
# true in prod (https://localhost:46443 served by Caddy).
SPORTSHOP_AUTH_COOKIE_SECURE=false

# --- Optional knobs (values below mirror the application.yaml defaults) ---

# Server + logging
SPORTSHOP_SERVER_PORT=8080
SPORTSHOP_LOG_LEVEL_APP=INFO

# Images (upload/serve tuning)
SPORTSHOP_IMAGES_CACHE_TTL_SECONDS=604800
SPORTSHOP_IMAGES_MAX_UPLOAD_BYTES=12MB
SPORTSHOP_IMAGES_UUID_RETRIES=5

# Auth (entropy + secret-length guardrails)
SPORTSHOP_AUTH_REFRESH_TOKEN_BYTES=32
SPORTSHOP_AUTH_MIN_SECRET_BYTES=32

# Checkout
SPORTSHOP_CHECKOUT_ORDER_NUMBER_RETRIES=5

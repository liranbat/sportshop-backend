# Copy to .env (gitignored). Local dev via springboot3-dotenv.

# --- Database connection ---
SPORTSHOP_DB_HOST=localhost
SPORTSHOP_DB_PORT=5432
SPORTSHOP_DB_NAME=sportshop
SPORTSHOP_DB_SCHEMA=sportshop
SPORTSHOP_DB_USER=sportshop_app
SPORTSHOP_DB_PASSWORD=change_me

# --- CORS ---
# Vite dev server origin (SPA at http://localhost:5173; /api proxied same-origin).
SPORTSHOP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Image storage ---
# Sibling folder on disk; SeedImagesBootstrap copies JAR seeds here on startup.
SPORTSHOP_IMAGES_LOCAL_DIR=../../images

# --- JWT / cookies ---
# Required — generate via `openssl rand -base64 48`.
SPORTSHOP_JWT_SECRET=hRdYi1nFwM4vCuaC/e9Uih6EdicnpC3BZ6oK8Tc1szKp6MHiEvf6enXlrhbUw1pz
SPORTSHOP_ACCESS_TOKEN_TTL=PT15M
SPORTSHOP_REFRESH_TOKEN_TTL=P14D
# false for plain http://localhost (browsers reject Secure cookies on http).
SPORTSHOP_AUTH_COOKIE_SECURE=false

# --- Optional knobs (values below mirror application.yaml defaults) ---

# Server + logging
SPORTSHOP_SERVER_PORT=8080
SPORTSHOP_LOG_LEVEL_APP=INFO

# Images (upload/serve tuning)
SPORTSHOP_IMAGES_CACHE_TTL_SECONDS=604800
SPORTSHOP_IMAGES_MAX_UPLOAD_BYTES=12MB
SPORTSHOP_IMAGES_UUID_RETRIES=5

# Auth (entropy + secret-length guardrails)
SPORTSHOP_AUTH_REFRESH_TOKEN_BYTES=32
SPORTSHOP_AUTH_MIN_SECRET_BYTES=32

# Cache (in-process Caffeine TTL for category list)
SPORTSHOP_CACHE_CATEGORIES_TTL=PT1M

# Checkout
SPORTSHOP_CHECKOUT_ORDER_NUMBER_RETRIES=5

# Payment (mock gateway: card numbers ending in this suffix are declined)
SPORTSHOP_PAYMENT_MOCK_DECLINE_SUFFIX=0000

# Database connection pool (async pools below reserve from this budget)
SPORTSHOP_DB_POOL_MAX=60

# Async thread pools (cleanup = post-delete work; sales = dashboard summary branches)
SPORTSHOP_ASYNC_CLEANUP_POOL_SIZE=6
SPORTSHOP_ASYNC_CLEANUP_QUEUE_CAPACITY=100
SPORTSHOP_ASYNC_CLEANUP_AWAIT_TERMINATION=30s
SPORTSHOP_ASYNC_SALES_POOL_SIZE=18
SPORTSHOP_ASYNC_SALES_QUEUE_CAPACITY=18
SPORTSHOP_ASYNC_SALES_AWAIT_TERMINATION=10s
SPORTSHOP_ASYNC_SALES_RESULTS_TIMEOUT=60s

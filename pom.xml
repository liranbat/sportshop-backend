<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath/>
	</parent>

	<groupId>com.java.sadna.backend</groupId>
	<artifactId>sportshop</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>sportshop</name>
	<description>Sportshop backend service</description>

	<properties>
		<java.version>21</java.version>
		<openapi-generator.version>7.20.0</openapi-generator.version>
		<spring-dotenv.version>5.1.0</spring-dotenv.version>
		<jjwt.version>0.12.6</jjwt.version>
		<tika.version>3.2.3</tika.version>
		<sportshop-swagger.version>feature-ci.1.0.2</sportshop-swagger.version>
		<openapi.specs.staged>${project.build.directory}/openapi</openapi.specs.staged>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>me.paulschwarz</groupId>
				<artifactId>spring-dotenv-bom</artifactId>
				<version>${spring-dotenv.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Spring Boot starters -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${tika.version}</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>me.paulschwarz</groupId>
			<artifactId>springboot3-dotenv</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Generates spring-configuration-metadata.json for @ConfigurationProperties
		     (IDE-only — silences "Unknown property 'app.*'"; not in the runtime jar). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Auto-restart on classpath changes during local dev. `optional=true`
		     keeps it out of downstream consumers and the repackaged fat jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>fetch-openapi-specs</id>
						<phase>initialize</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<mkdir dir="${openapi.specs.staged}"/>
								<get src="https://github.com/liranbat/sportshop-swagger/releases/download/${sportshop-swagger.version}/sportshop-swagger-${sportshop-swagger.version}.zip"
								     dest="${project.build.directory}/sportshop-swagger.zip"
								     verbose="true"
								     usetimestamp="true"/>
								<unzip src="${project.build.directory}/sportshop-swagger.zip"
								       dest="${openapi.specs.staged}"
								       overwrite="true"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<executions>
					<execution>
						<id>generate-categories-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/categories-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.categories.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.categories.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>generate-auth-and-users-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/auth-and-users-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.authusers.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.authusers.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>generate-products-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/products-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.products.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.products.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>generate-cart-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/cart-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.cart.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.cart.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>generate-checkout-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/checkout-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.checkout.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.checkout.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>generate-orders-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/orders-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.orders.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.orders.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>generate-admin-images-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/admin-images-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.adminimages.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.adminimages.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
					<execution>
						<id>generate-stock-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${openapi.specs.staged}/stock-api.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.java.sadna.backend.sportshop.api.generated.stock.api</apiPackage>
							<modelPackage>com.java.sadna.backend.sportshop.api.generated.stock.model</modelPackage>
							<generateApiTests>false</generateApiTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelTests>false</generateModelTests>
							<generateModelDocumentation>false</generateModelDocumentation>
							<generateSupportingFiles>false</generateSupportingFiles>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<openApiNullable>false</openApiNullable>
								<skipDefaultInterface>true</skipDefaultInterface>
								<documentationProvider>none</documentationProvider>
							</configOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- -Plocal-specs: source YAMLs from ../sportshop-swagger/ instead of the release zip. -->
		<profile>
			<id>local-specs</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<!-- Override: matching id + phase=none disables the inherited fetch execution. -->
								<id>fetch-openapi-specs</id>
								<phase>none</phase>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>stage-local-openapi-specs</id>
								<phase>initialize</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${openapi.specs.staged}</outputDirectory>
									<resources>
										<resource>
											<directory>${project.basedir}/../sportshop-swagger</directory>
											<includes>
												<include>*.yaml</include>
												<include>*.yml</include>
											</includes>
											<filtering>false</filtering>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
